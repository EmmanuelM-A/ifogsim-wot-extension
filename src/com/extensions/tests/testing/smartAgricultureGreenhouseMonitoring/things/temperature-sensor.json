	  "op": [
		"readallproperties",
		"readmultipleproperties",
		"writeallproperties",
		"writemultipleproperties"
	  ]
	},
	{
	  "href": "http://10.32.151.21:8081/temperature-sensor/properties",
	  "contentType": "application/cbor",
	  "op": [
		"readallproperties",
		"readmultipleproperties",
		"writeallproperties",
		"writemultipleproperties"
	  ]
	}
  ]
}