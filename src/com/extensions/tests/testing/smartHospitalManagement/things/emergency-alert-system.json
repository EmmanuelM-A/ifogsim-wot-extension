{
  "@context": "https://www.w3.org/2019/wot/td/v1",
  "id": "urn:uuid:emergency-alert-system",
  "title": "Emergency Alert System",
  "description": "Comprehensive multi-channel emergency notification and communication platform",
  "properties": {
      "systemStatus": {
          "type": "string",
          "readOnly": true,
          "description": "Current operational status of the emergency alert system",
          "enum": ["active", "standby", "maintenance", "offline"]
      },
      "activeAlertChannels": {
          "type": "array",
          "readOnly": true,
          "description": "Currently active communication channels",
          "items": {
              "type": "string",
              "enum": ["SMS", "email", "push notification", "landline", "radio", "television"]
          }
      },
      "coverageRadius": {
          "type": "number",
          "unit": "kilometers",
          "readOnly": true,
          "description": "Effective communication range of the alert system"
      }
  },
  "actions": {
      "triggerEmergencyAlert": {
          "description": "Initiate a comprehensive emergency notification across multiple channels",
          "input": {
              "type": "object",
              "properties": {
                  "emergencyType": {
                      "type": "string",
                      "enum": [
                          "natural disaster",
                          "public safety",
                          "health emergency",
                          "security threat",
                          "infrastructure failure",
                          "environmental hazard"
                      ]
                  },
                  "severityLevel": {
                      "type": "string",
                      "enum": ["low", "moderate", "high", "critical"]
                  },
                  "targetArea": {
                      "type": "object",
                      "properties": {
                          "coordinates": {
                              "type": "object",
                              "properties": {
                                  "latitude": {"type": "number"},
                                  "longitude": {"type": "number"}
                              }
                          },
                          "radius": {"type": "number", "unit": "kilometers"}
                      }
                  },
                  "alertMessage": {
                      "type": "object",
                      "properties": {
                          "title": {"type": "string"},
                          "body": {"type": "string"},
                          "languageOptions": {"type": "array", "items": {"type": "string"}}
                      }
                  },
                  "communicationChannels": {
                      "type": "array",
                      "items": {
                          "type": "string",
                          "enum": ["SMS", "email", "push notification", "landline", "radio", "television"]
                      }
                  }
              }
          },
          "output": {
              "type": "object",
              "properties": {
                  "alertId": {"type": "string"},
                  "distributionStatus": {"type": "string"},
                  "estimatedReach": {"type": "number", "unit": "percentage"}
              }
          }
      },
      "configureAlertProtocol": {
          "description": "Modify emergency alert system configuration and protocols",
          "input": {
              "type": "object",
              "properties": {
                  "priorityChannels": {
                      "type": "array",
                      "items": {
                          "type": "string",
                          "enum": ["SMS", "email", "push notification", "landline", "radio", "television"]
                      }
                  },
                  "escalationProcedures": {
                      "type": "object",
                      "properties": {
                          "responseTimeLimits": {"type": "number", "unit": "minutes"},
                          "additionalContactProtocol": {"type": "string"}
                      }
                  }
              }
          },
          "output": {
              "type": "object",
              "properties": {
                  "configurationId": {"type": "string"},
                  "implementationStatus": {"type": "string"}
              }
          }
      }
  },
  "events": {
      "emergencyAlertTriggered": {
          "description": "Detailed event data when an emergency alert is activated",
          "data": {
              "type": "object",
              "properties": {
                  "alertType": {"type": "string"},
                  "severityLevel": {"type": "string"},
                  "timestamp": {"type": "string", "format": "date-time"},
                  "affectedArea": {
                      "type": "object",
                      "properties": {
                          "coordinates": {
                              "type": "object",
                              "properties": {
                                  "latitude": {"type": "number"},
                                  "longitude": {"type": "number"}
                              }
                          },
                          "radius": {"type": "number"}
                      }
                  },
                  "channelsUsed": {"type": "array", "items": {"type": "string"}}
              }
          }
      },
      "systemHealthCheck": {
          "description": "Periodic system status and operational readiness report",
          "data": {
              "type": "object",
              "properties": {
                  "systemIntegrity": {"type": "number", "unit": "percentage"},
                  "communicationChannelStatus": {
                      "type": "object",
                      "additionalProperties": {
                          "type": "string",
                          "enum": ["operational", "partial", "offline"]
                      }
                  },
                  "lastMaintenanceDate": {"type": "string", "format": "date"}
              }
          }
      }
  }
}