	"events": {
		"occupancyChange": {
			"description": "Triggered when the occupancy status changes.",
			"data": {
				"type": "boolean"
			},
			"forms": [
				{
					"href": "http://10.32.154.144:8081/smart-bed/events/occupancyChange",
					"contentType": "application/json",
					"subprotocol": "longpoll",
					"op": [
						"subscribeevent",
						"unsubscribeevent"
					]
				},
				{
					"href": "http://10.32.154.144:8081/smart-bed/events/occupancyChange",
					"contentType": "application/cbor",
					"subprotocol": "longpoll",
					"op": [
						"subscribeevent",
						"unsubscribeevent"
					]
				}
			]
		}
