				{
					"href": "http://10.32.154.144:8081/smart-bed/properties/inclineLevel",
					"contentType": "application/json",
					"op": [
						"readproperty",
						"writeproperty"
					]
				},
				{
					"href": "http://10.32.154.144:8081/smart-bed/properties/inclineLevel",
					"contentType": "application/cbor",
					"op": [
						"readproperty",
						"writeproperty"
					]
				}
			],
			"readOnly": false,
			"writeOnly": false,
			"observable": false
		},
		"firmnessLevel": {
			"type": "number",
			"description": "The current firmness level (1-10).",
			"minimum": 1,
			"maximum": 10,
			"forms": [
				{
					"href": "http://10.32.154.144:8081/smart-bed/properties/firmnessLevel",
					"contentType": "application/json",
					"op": [
						"readproperty",
						"writeproperty"
					]
				},
				{
					"href": "http://10.32.154.144:8081/smart-bed/properties/firmnessLevel",
					"contentType": "application/cbor",
					"op": [
						"readproperty",
						"writeproperty"
					]
				}
			],
			"readOnly": false,
			"writeOnly": false,
			"observable": false
		},
		"status": {
			"type": "string",
			"enum": [
				"active",
				"inactive",
				"error"
			],
			"description": "The current status of the smart bed.",
			"forms": [
				{
					"href": "http://10.32.154.144:8081/smart-bed/properties/status",
					"contentType": "application/json",
					"op": [
						"readproperty",
						"writeproperty"
					]
				},
				{
					"href": "http://10.32.154.144:8081/smart-bed/properties/status",
					"contentType": "application/cbor",
					"op": [
						"readproperty",
						"writeproperty"
					]
				}
			],
			"readOnly": false,
			"writeOnly": false,
			"observable": false
		}
