{
	"@context": [
		"https://www.w3.org/2019/wot/td/v1",
		{
			"@language": "en"
		}
	],
	"@type": "Thing",
	"title": "Smart Bed",
	"securityDefinitions": {
		"nosec": {
			"scheme": "nosec"
		}
	},
	"security": [
		"nosec"
	],
	"properties": {
