			"type": "boolean",
			"description": "Indicates if the bed is currently occupied.",
			"readOnly": true,
			"observable": true,
			"forms": [
				{
					"href": "http://10.32.154.144:8081/smart-bed/properties/occupancy",
					"contentType": "application/json",
					"op": [
						"readproperty"
					],
					"htv:methodName": "GET"
				},
				{
					"href": "http://10.32.154.144:8081/smart-bed/properties/occupancy/observable",
					"contentType": "application/json",
					"op": [
						"observeproperty",
						"unobserveproperty"
					],
					"subprotocol": "longpoll"
				},
				{
					"href": "http://10.32.154.144:8081/smart-bed/properties/occupancy",
