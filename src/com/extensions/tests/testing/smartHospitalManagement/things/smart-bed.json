				{
					"href": "http://10.32.154.144:8081/smart-bed/actions/adjustFirmness",
					"contentType": "application/json",
					"op": [
						"invokeaction"
					],
					"htv:methodName": "POST"
				},
				{
					"href": "http://10.32.154.144:8081/smart-bed/actions/adjustFirmness",
					"contentType": "application/cbor",
					"op": [
						"invokeaction"
					],
					"htv:methodName": "POST"
				}
			],
			"safe": false,
			"idempotent": false
		}
