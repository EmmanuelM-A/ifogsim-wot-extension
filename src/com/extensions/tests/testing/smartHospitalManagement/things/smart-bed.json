	"id": "urn:uuid:cc52fbd1-84b0-4dbd-8860-291f63b74dc8",
	"description": "A bed that adjusts firmness and incline based on user preferences.",
	"forms": [
		{
			"href": "http://10.32.154.144:8081/smart-bed/properties",
			"contentType": "application/json",
			"op": [
				"readallproperties",
