{
  "@context": "https://www.w3.org/2019/wot/td/v1",
  "id": "urn:dev:wot:com:example:temp-sensor-001",
  "title": "TemperatureSensor",
  "description": "A simple temperature sensor that sends readings.",
  "securityDefinitions": {
    "noSec": {
      "scheme": "nosec"
    }
  },
  "security": ["noSec"],
  "properties": {
    "temperature": {
      "type": "number",
      "description": "Current temperature reading in Celsius.",
      "readOnly": true,
      "observable": true
    },
    "humidity": {
      "type": "number",
      "description": "Current humidity percentage.",
      "readOnly": true,
      "observable": true,
      "forms": [
        {
          "href": "https://example.com/temp-sensor/properties/humidity",
          "contentType": "application/json",
          "op": ["readproperty", "observeproperty"]
        }
      ]
    }
  },
  "actions": {
    "reset": {
      "description": "Resets the temperature sensor to its default state.",
      "inputSchema": {
        "type": "null"
      }
    },
    "calibrate": {
      "description": "Calibrates the temperature sensor.",
      "input": {
        "type": "object",
        "properties": {
          "calibrationValue": {
            "type": "number",
            "description": "Calibration offset value in Celsius."
          }
        },
        "required": ["calibrationValue"]
      },
      "forms": [
        {
          "href": "https://example.com/temp-sensor/actions/calibrate",
          "contentType": "application/json",
          "op": ["invokeaction"]
        }
      ]
    }
  },
  "events": {
    "overheat": {
      "description": "Triggered when the temperature exceeds a threshold.",
      "data": {
        "type": "number"
      }
    }
  }
}