	  "forms": [
		{
		  "href": "http://10.32.154.144:8081/smart-camera/properties/lastSnapshot",
		  "contentType": "application/json",
		  "op": [
			"readproperty"
		  ],
		  "htv:methodName": "GET"
		},
		{
		  "href": "http://10.32.154.144:8081/smart-camera/properties/lastSnapshot",
