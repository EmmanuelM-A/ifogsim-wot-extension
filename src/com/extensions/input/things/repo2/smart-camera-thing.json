		  "op": [
			"readproperty"
		  ],
		  "htv:methodName": "GET"
		}
	  ],
	  "writeOnly": false,
	  "observable": false
	},
	"lastSnapshot": {
	  "type": "string",
	  "description": "Base64 encoded image of the last snapshot.",
